#!/usr/bin/env ruby
# Generates chronological_list_of_events.md — one prose paragraph per month,
# written by Claude AI from the post descriptions and section headers.
#
# Usage: ANTHROPIC_API_KEY=sk-... ./script/timeline
#        Resumable: already-written months are skipped.

require "net/http"
require "uri"
require "json"
require "date"

REPO_ROOT  = File.expand_path("..", __dir__)
POSTS_DIR  = File.join(REPO_ROOT, "posts")
OUTPUT     = File.join(REPO_ROOT, "chronological_list_of_events.md")
MODEL      = "claude-haiku-4-5-20251001"
MONTH_ABBR = %w[_ JAN FEB MAR APR MAY JUN JUL AUG SEP OCT NOV DEC].freeze

COUNTRIES = [
  "Afghanistan", "Albania", "Algeria", "Austria", "Azerbaijan", "Belgium",
  "Bosnia", "Bulgaria", "Croatia", "Cyprus", "Czech Republic", "Denmark",
  "Egypt", "Ethiopia", "Finland", "France", "Georgia", "Germany", "Greece",
  "Hungary", "India", "Iran", "Iraq", "Ireland", "Italy", "Jordan", "Kosovo",
  "Lebanon", "Libya", "Lithuania", "Luxembourg", "Macedonia", "Malta",
  "Montenegro", "Morocco", "Netherlands", "Nigeria", "North Macedonia",
  "Norway", "Pakistan", "Palestine", "Poland", "Portugal", "Romania",
  "Russia", "Serbia", "Slovenia", "Somalia", "Spain", "Sudan", "Sweden",
  "Switzerland", "Syria", "Tunisia", "Turkey", "Ukraine", "United Kingdom",
  "United States", "Yemen"
].freeze
COUNTRY_RE = /\b(?:#{COUNTRIES.sort_by { |c| -c.length }.map { |c| Regexp.escape(c) }.join("|")})\b/i

# ── helpers ───────────────────────────────────────────────────────────────────

def parse_frontmatter(content)
  return {} unless content.start_with?("---")
  fm_end = content.index("\n---\n", 4)
  return {} unless fm_end
  result = {}
  i = 0
  lines = content[4..fm_end - 1].lines
  while i < lines.size
    if (m = lines[i].match(/\A(title|date|description):\s*(.*)/))
      key = m[1]
      val = m[2].strip.gsub(/\A["']|["']\z/, "")
      if val == ">" || val == "|"
        i += 1
        block = []
        block << lines[i].strip && i += 1 while i < lines.size && lines[i].match(/\A\s+/)
        result[key] = block.join(" ")
        next
      end
      result[key] = val
    end
    i += 1
  end
  result
end

def clean(text)
  text.gsub(/\[([^\]]+)\]\([^)]+\)/, '\1')
      .gsub(/\*+([^*]+)\*+/, '\1')
      .gsub(/\\(.)/, '\1')
      .gsub(/\s+/, " ")
      .strip
end

def claude(api_key, prompt, retries: 3)
  uri  = URI.parse("https://api.anthropic.com/v1/messages")
  body = JSON.generate(model: MODEL, max_tokens: 512,
                       messages: [{ role: "user", content: prompt }])
  retries.times do |attempt|
    req = Net::HTTP::Post.new(uri)
    req["x-api-key"]         = api_key
    req["anthropic-version"] = "2023-06-01"
    req["content-type"]      = "application/json"
    req.body = body
    res = Net::HTTP.start(uri.host, uri.port, use_ssl: true,
                          open_timeout: 30, read_timeout: 60) { |h| h.request(req) }
    case res.code.to_i
    when 200
      return JSON.parse(res.body).dig("content", 0, "text").to_s.strip
    when 429, 500..599
      wait = 2 ** attempt
      warn "  #{res.code} — retry in #{wait}s"
      sleep wait
    else
      warn "  API error #{res.code}: #{res.body[0..120]}"
      return nil
    end
  end
  nil
rescue => e
  warn "  Request failed: #{e.message}"
  nil
end

# ── main ──────────────────────────────────────────────────────────────────────

api_key = ENV["ANTHROPIC_API_KEY"].to_s.strip
if api_key.empty?
  abort "Error: ANTHROPIC_API_KEY not set."
end

existing    = File.exist?(OUTPUT) ? File.read(OUTPUT, encoding: "utf-8") : ""
done_months = existing.scan(/^## \d{4}-[A-Z]{3}/).map { |h| h.sub("## ", "") }.to_set

puts "==> Reading #{POSTS_DIR}…"
posts = []
Dir.glob(File.join(POSTS_DIR, "*.md")).sort.each do |path|
  content = File.read(path, encoding: "utf-8", invalid: :replace, undef: :replace)
  fm      = parse_frontmatter(content)
  next unless fm["date"]
  date_str = fm["date"].to_s[0, 10]
  next unless date_str =~ /\A\d{4}-\d{2}-\d{2}\z/

  body = content.sub(/\A---.*?^---\n/m, "")
  event_headers = body.scan(/^[#]{3,4}\s+(.+)/).flatten
                      .map  { |h| clean(h) }
                      .select { |h| h.length >= 30 }
                      .reject { |h| COUNTRY_RE.match?(h) && h.gsub(COUNTRY_RE, "").strip.empty? }

  posts << {
    date:          date_str,
    month:         date_str[0, 7],
    description:   fm["description"].to_s.strip,
    event_headers: event_headers
  }
end

by_month = posts.group_by { |p| p[:month] }.sort.to_h
puts "Found #{posts.size} posts across #{by_month.size} months.\n\n"

out = File.open(OUTPUT, "a")
if existing.strip.empty?
  out.puts "# Chronological Events — AreYouSyrious (2016–2025)"
  out.puts ""
end

by_month.each do |month, month_posts|
  year, mon = month.split("-").map(&:to_i)
  label     = "#{year}-#{MONTH_ABBR[mon]}"

  if done_months.include?(label)
    print "."
    $stdout.flush
    next
  end

  # One block per post: date + description segments + notable event headers
  blocks = month_posts.map do |p|
    segs = p[:description].split(%r{ */{2,3} *|\s+/\s+|✔})
                          .map { |s| clean(s) }.reject { |s| s.length < 20 }
    lines = ["[#{p[:date]}]"]
    lines.concat(segs.first(4).map { |s| "  - #{s}" })
    p[:event_headers].first(3).each { |h| lines << "  • #{h}" }
    lines.join("\n")
  end.join("\n\n")

  prompt = <<~PROMPT
    You are writing a monthly journal entry for the refugee/migration news archive "Are You Syrious?" (2016–2025).

    Below are key events from #{Date::MONTHNAMES[mon]} #{year}, extracted from #{month_posts.size} daily digests:

    #{blocks}

    Write a single dense prose paragraph (no headings, no bullets, no lists) summarising the most significant events of that month. Focus on concrete events: deaths at sea, border violence, legal rulings, protests, policy changes, camp conditions. Journalistic tone, factual. Do not open with "In #{Date::MONTHNAMES[mon]}" or the month name. Output only the paragraph, nothing else.
  PROMPT

  para = claude(api_key, prompt)

  if para.nil? || para.empty?
    warn "\n  Skipped #{label} — no API response"
    next
  end

  out.puts "## #{label}"
  out.puts para
  out.puts ""
  out.flush

  puts "  #{label} (#{month_posts.size} posts)"
  sleep 0.25
end

out.close
puts "\nDone → #{OUTPUT}"
